{
  "name": "satoriapp",
  "version": "0.1.0",
  "packageManager": "yarn@4.4.0",
  "description": "Satori App for Desktop",
  "author": {
    "name": "Lipraty",
    "email": "i@lonay.me"
  },
  "contributors": [
    {
      "name": "MaikoTan",
      "email": "maiko.tan.coding@gmail.com"
    }
  ],
  "license": "AGPL-3.0-only",
  "exports": {
    "./main": {
      "types": "./src/main/index.ts"
    },
    "./renderer": {
      "types": "./src/renderer/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./out/main/index.mjs",
  "bin": {
    "electron-filter": "../../script/cli.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@cordisjs/plugin-database": "^4.0.1",
    "@cordisjs/plugin-database-sqlite": "^5.0.4",
    "@cordisjs/plugin-http": "^1.5.0",
    "@cordisjs/plugin-loader": "^1.0.0-rc.3",
    "@cordisjs/plugin-logger": "^1.0.2",
    "@cordisjs/plugin-server": "^1.5.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@satoriapp/adapter": "workspace:*",
    "@satoriapp/electron-loader": "workspace:*",
    "@satoriapp/plugin-app-server": "workspace:*",
    "@satoriapp/plugin-client-config": "workspace:*",
    "@satoriapp/plugin-client-messages": "workspace:*",
    "@satoriapp/plugin-client-person": "workspace:*",
    "@satoriapp/plugin-conversation-sync": "workspace:*",
    "@satoriapp/plugin-link-ipc": "workspace:*",
    "@satoriapp/plugin-message": "workspace:*",
    "@satoriapp/plugin-msgdb": "workspace:*",
    "@satoriapp/plugin-resource-store": "workspace:*",
    "@satoriapp/plugin-state": "workspace:*",
    "@satoriapp/state": "workspace:*",
    "@satoriapp/webui": "workspace:*",
    "cordis": "^4.0.0-rc.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.3.9",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "35.1.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "es-module-lexer": "^1.7.0",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.0.0",
    "magic-string": "^0.30.17",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.98.0",
    "typescript": "^6.0.3",
    "vite": "^6.2.6",
    "vue-tsc": "^2.2.12"
  }
}
